<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>Rendez-vous d'urgence – Médecin</title>
<link rel="icon" type="image/png" href="logog2.png">
<style>
:root{--font:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;--bg:#fff;--ink:#112336;--muted:#586a7e;--line:#d8e1ea;--line-soft:#e9eff5;--field:#f6f9fc;--primary:#0b6fa4;--primary-d:#085a86;--primary-soft:#e3f1f9;--ok:#16784a;--ok-soft:#e1f4e9;--late:#b92a30;--late-soft:#fdecec;--plan:#4a5b6e;--plan-soft:#eceff3;--shadow:0 1px 2px rgba(17,35,54,.05),0 8px 24px rgba(17,35,54,.07);--ring:0 0 0 4px rgba(11,111,164,.15)}
*{box-sizing:border-box}[hidden]{display:none!important}
html,body{margin:0;min-height:100%}
body{font-family:var(--font);font-size:16px;line-height:1.45;color:var(--ink);background:var(--bg)}
h1,h2,h3,p{margin:0}
header{display:flex;align-items:center;gap:12px;min-height:64px;padding:8px 20px;border-bottom:1px solid var(--line)}
.brand{width:38px;height:38px;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,var(--primary),var(--primary-d));border-radius:11px;box-shadow:0 4px 10px rgba(11,111,164,.25)}
.brand svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.kicker{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
h1{font-size:18px;font-weight:700;letter-spacing:-.01em}
#who{margin-left:auto;font-size:14px;font-weight:600;color:var(--muted)}
main{padding:20px clamp(16px,3vw,32px) 48px}
.bar{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-bottom:18px}
.bar .field{width:200px}
.field label,.lbl{display:block;font-size:13px;font-weight:600;color:var(--muted);margin-bottom:6px}
input,select,textarea{width:100%;min-height:44px;padding:10px 12px;font:500 15px var(--font);color:var(--ink);background:var(--field);border:1px solid var(--line);border-radius:12px}
textarea{min-height:100px;resize:vertical}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--primary);box-shadow:var(--ring);background:#fff}
.split{display:grid;grid-template-columns:minmax(260px,380px) minmax(0,1fr);gap:20px;align-items:start}
@media(max-width:820px){.split{grid-template-columns:1fr}}
.card-sec{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:20px;margin-bottom:16px}
.card-title{font-size:16px;font-weight:700;margin-bottom:10px}
.rdv{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;text-align:left;font:inherit;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:8px;cursor:pointer}
.rdv:hover{background:var(--primary-soft)}.rdv[aria-current=true]{border-color:var(--primary);box-shadow:var(--ring);background:var(--primary-soft)}
.rdv b{font-variant-numeric:tabular-nums}.rdv small{display:block;color:var(--muted)}
.pill{display:inline-block;padding:3px 10px;font-size:12px;font-weight:700;border-radius:999px;white-space:nowrap}
.pill.pris{background:var(--primary-soft);color:var(--primary-d)}.pill.encours{background:#fff5da;color:#7a4f00}.pill.termine{background:var(--ok-soft);color:var(--ok)}.pill.annule{background:var(--late-soft);color:var(--late)}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:14px}
.fact{padding:10px 12px;background:var(--field);border:1px solid var(--line-soft);border-radius:12px}
.fact label{margin:0 0 2px}.fact span{font-weight:600;word-break:break-word}
.choice{display:flex;gap:10px;align-items:flex-start;padding:12px;border:1px solid var(--line);border-radius:12px;margin-bottom:8px;cursor:pointer}
.choice input{width:auto;min-height:0;margin-top:4px}
.choice.on{border-color:var(--primary);background:var(--primary-soft)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:12px}
.btn-primary,.btn-secondary,.btn-danger{appearance:none;min-height:46px;padding:0 18px;font:600 15px var(--font);border-radius:12px;cursor:pointer;border:1px solid var(--primary)}
.btn-primary{background:var(--primary);color:#fff}.btn-primary:active{background:var(--primary-d)}.btn-primary:disabled{opacity:.45;cursor:not-allowed}
.btn-secondary{background:#fff;color:var(--primary);border-color:var(--line)}.btn-secondary:hover{background:var(--primary-soft)}
.btn-danger{background:#fff;color:var(--late);border-color:#f0c3c5}.btn-danger:hover{background:var(--late-soft)}
:is(button,summary):focus-visible{outline:3px solid rgba(11,111,164,.4);outline-offset:2px}
.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.hist{border-left:3px solid var(--primary-soft);padding:2px 0 2px 12px;margin-bottom:12px;font-size:14px}
.hist .d{font-weight:700}.hist em{color:var(--muted);font-style:normal;font-weight:600}
.msg{padding:14px 16px;border-radius:12px;background:var(--late-soft);color:var(--late);font-weight:600}
.okbox{padding:12px 14px;border-radius:12px;background:var(--ok-soft);color:var(--ok);font-weight:600;margin-bottom:12px}
.mut{color:var(--muted)}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:10px 18px;border-radius:999px;background:var(--ink);color:#fff;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s}
#toast.on{opacity:1}
</style>
</head>
<body>
<header>
  <div class="brand"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4M16 2v4M3 10h18M12 13v5M9.5 15.5h5"/></svg></div>
  <div><div class="kicker">Urgences · Médecin</div><h1>Rendez-vous et consultations</h1></div>
  <span id="who"></span>
</header>
<main>
  <div id="gate" class="msg">Connexion en cours…</div>
  <div id="app" hidden>
    <div class="bar"><div class="field"><label for="jour">Date</label><input id="jour" type="date"></div></div>
    <div class="split">
      <div id="liste"></div>
      <div id="detail"><div class="card-sec mut">Sélectionnez un rendez-vous pour ouvrir le dossier.</div></div>
    </div>
  </div>
</main>
<div id="toast" role="status"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getFirestore, doc, getDoc, getDocs, addDoc, setDoc, updateDoc, collection, query, where, limit, onSnapshot, runTransaction, serverTimestamp, Timestamp, arrayUnion } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
const app=initializeApp({apiKey:"AIzaSyBKp5-7NNy0Gyl0tNbDgD-BxucYdg8ArWo",authDomain:"urgences-a8ed4.firebaseapp.com",projectId:"urgences-a8ed4"});
const auth=getAuth(app),db=getFirestore(app);
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const iso=d=>{const z=new Date(d-d.getTimezoneOffset()*6e4);return z.toISOString().slice(0,10)};
const STAT={pris:'À voir',encours:'En consultation',termine:'Terminé',annule:'Annulé'};
let medecin={},rdvs=[],sel=null,unsub=null;
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');setTimeout(()=>e.classList.remove('on'),1800)}

// Même contrôle d'accès que fiche.html : medecins/{uid}.pages["rdv-medecin"]
onAuthStateChanged(auth,async user=>{
  if(!user){$('#gate').textContent='Vous devez être connecté pour accéder à cette page.';return}
  try{
    const m=await getDoc(doc(db,'medecins',user.uid));
    const page=location.pathname.split('/').pop().replace('.html','');
    if(!m.exists()||!(m.data().pages||{})[page]){$('#gate').textContent='Accès refusé : cette page n’est pas autorisée pour votre compte.';return}
    medecin={...m.data(),uid:user.uid};$('#who').textContent=medecin.nom||'';
    $('#gate').hidden=true;$('#app').hidden=false;$('#jour').value=iso(new Date());ecouter();
  }catch(e){$('#gate').textContent='Erreur de chargement. Rechargez la page.'}
});
$('#jour').onchange=()=>{sel=null;ecouter()};

function ecouter(){
  if(unsub)unsub();
  unsub=onSnapshot(query(collection(db,'rdv-urgences'),where('date','==',$('#jour').value)),s=>{
    rdvs=s.docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>a.heure.localeCompare(b.heure));
    rendreListe();const r=rdvs.find(x=>x.id===sel);if(r&&!document.activeElement.closest('#detail'))ouvrir(r);
  });
}
function rendreListe(){
  $('#liste').innerHTML=rdvs.map(r=>`<button class="rdv" data-id="${r.id}" ${r.id===sel?'aria-current="true"':''}><span><b>${esc(r.heure)}</b> ${esc(r.patient.prenom)} ${esc(r.patient.nom)}<small>${esc(r.motif)}</small></span><span class="pill ${r.statut}">${STAT[r.statut]}</span></button>`).join('')||'<p class="mut">Aucun rendez-vous ce jour-là.</p>';
  document.querySelectorAll('.rdv').forEach(b=>b.onclick=()=>{sel=b.dataset.id;rendreListe();ouvrir(rdvs.find(x=>x.id===sel))});
}

/* ---- Fiche patient : recherche via searchIndex (comme ajouterpatient.html) ---- */
function buildSearchIndex(nom,prenom,dn){
  const n=(nom||'').toLowerCase(),p=(prenom||'').toLowerCase(),idx=new Set();
  for(const w of [n,p])for(let i=1;i<=w.length;i++)idx.add(w.slice(0,i));
  idx.add(n+' '+p);idx.add(p+' '+n);
  const d=new Date(dn);
  if(dn&&!isNaN(d)){const j=String(d.getDate()).padStart(2,'0'),m=String(d.getMonth()+1).padStart(2,'0'),a=d.getFullYear();idx.add(`${j}${m}${a}`);idx.add(`${j}/${m}/${a}`);idx.add(String(a))}
  return [...idx];
}
async function candidats(p){
  const out=new Map(),d=new Date(p.dateNaissance),n=p.nom.toLowerCase(),pr=p.prenom.toLowerCase();
  const keys=[n+' '+pr,pr+' '+n];
  if(!isNaN(d))keys.push(`${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`);
  for(const k of keys){try{(await getDocs(query(collection(db,'patients'),where('searchIndex','array-contains',k),limit(10)))).forEach(x=>out.set(x.id,{id:x.id,...x.data()}))}catch(e){}}
  return [...out.values()].sort((a,b)=>((b.dateNaissance===p.dateNaissance)-(a.dateNaissance===p.dateNaissance)));
}
async function creerConsultation(r,pid){
  const n=new Date();
  const ref=await addDoc(collection(db,'consultations'),{
    patientId:pid,rdvId:r.id,date:n.toLocaleDateString('fr-FR'),heure:n.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}),dateTS:Timestamp.now(),
    motif:r.motif,histoire:r.detail||'',examenClinique:'',diagnostic:'',conduite:'',statut:'encours',
    medecinId:medecin.uid,medecinNom:medecin.nom||'',medecinSpecialite:medecin.specialite||'',origine:'rdv-urgences'});
  // La fiche patient ne conserve que les ids des consultations
  await updateDoc(doc(db,'patients',pid),{consultations:arrayUnion(ref.id)});
  await updateDoc(doc(db,'rdv-urgences',r.id),{patientId:pid,consultationId:ref.id,statut:'encours'});
  return ref.id;
}
const urlConsult=id=>'consultation.html?id='+encodeURIComponent(id);

async function ouvrir(r){
  if(!r)return;const p=r.patient,box=$('#detail');
  let html=`<div class="card-sec"><div style="display:flex;justify-content:space-between;gap:10px;margin-bottom:12px"><h2 class="card-title" style="margin:0">${esc(p.prenom)} ${esc(p.nom)}</h2><span class="pill ${r.statut}">${STAT[r.statut]}</span></div>
    <div class="facts"><div class="fact"><label>Naissance</label><span>${esc(p.dateNaissance)}</span></div><div class="fact"><label>Téléphone</label><span>${esc(p.telephone)}</span></div><div class="fact"><label>E-mail</label><span>${esc(p.email||'—')}</span></div><div class="fact"><label>Créneau</label><span>${esc(r.heure)} · ${esc(r.ref)}</span></div></div>
    <div class="fact"><label>Motif</label><span>${esc(r.motif)}${r.detail?' — '+esc(r.detail):''}</span></div></div>`;
  if(r.consultationId)html+=`<div class="card-sec"><h2 class="card-title">Consultation</h2><div class="actions"><a class="btn-primary" style="display:inline-flex;align-items:center;text-decoration:none" href="${urlConsult(r.consultationId)}">Ouvrir la consultation</a></div></div>`;
  else if(r.statut==='pris')html+=`<div class="card-sec"><h2 class="card-title">Fiche patient</h2><div id="fiche"><p class="mut">Recherche des fiches existantes…</p></div></div>`;
  if(r.statut==='pris')html+=`<div class="actions"><button class="btn-danger" id="cancel">Annuler le rendez-vous</button></div>`;
  box.innerHTML=html;

  const fiche=$('#fiche');
  if(fiche){
    const cands=await candidats(p);
    fiche.innerHTML=(cands.length?`<p class="mut" style="margin-bottom:10px">Fiches correspondantes trouvées :</p>`+cands.map((c,i)=>`<label class="choice ${i===0?'on':''}"><input type="radio" name="f" value="${c.id}" ${i===0?'checked':''}><span><b>${esc(c.nom)} ${esc(c.prenom)}</b><br><small class="mut">Né(e) le ${esc(c.dateNaissance||'—')} · ${esc(c.telephone||'—')} · CIP ${esc(c.id)}</small></span></label>`).join(''):'<p class="mut" style="margin-bottom:10px">Aucune fiche existante ne correspond.</p>')+
      `<label class="choice ${cands.length?'':'on'}"><input type="radio" name="f" value="new" ${cands.length?'':'checked'}><span><b>Créer une nouvelle fiche patient</b></span></label><div class="actions"><button class="btn-primary" id="demarrer">Démarrer la consultation</button></div>`;
    fiche.querySelectorAll('input[name=f]').forEach(i=>i.onchange=()=>fiche.querySelectorAll('.choice').forEach(c=>c.classList.toggle('on',c.querySelector('input').checked)));
    $('#demarrer').onclick=async()=>{
      $('#demarrer').disabled=true;
      const v=fiche.querySelector('input[name=f]:checked').value;
      try{
        let pid=v;
        if(v==='new'){
          // Même structure que ajouterpatient.html, sans hospitalisation
          const nom=p.nom.toUpperCase();
          pid=(await addDoc(collection(db,'patients'),{nom,prenom:p.prenom,sexe:'',civilite:'',dateNaissance:p.dateNaissance,adresse:'',telephone:p.telephone,email:p.email||'',
            hospitalisations:[],hospitalisationActiveId:null,hospitalisationActive:false,consultations:[],
            medtraitant:'',vigilances:'aucune',allergies:'aucun',searchIndex:buildSearchIndex(nom,p.prenom,p.dateNaissance)})).id;
        }
        const cid=await creerConsultation(r,pid);
        location.href=urlConsult(cid);
      }catch(e){console.error(e);toast('Échec de la création de la consultation');$('#demarrer').disabled=false}
    };
  }
  if($('#cancel'))$('#cancel').onclick=async()=>{
    if(!confirm('Annuler ce rendez-vous ? Le créneau sera libéré.'))return;
    try{
      await runTransaction(db,async tx=>{
        const oref=doc(db,'rdv-occupation',r.date),o=await tx.get(oref);
        if(o.exists()){const c=o.data().counts||{};c[r.heure]=Math.max(0,(c[r.heure]||1)-1);tx.update(oref,{counts:c})}
        tx.update(doc(db,'rdv-urgences',r.id),{statut:'annule',annuleLe:serverTimestamp()});
      });toast('Rendez-vous annulé');
    }catch(e){toast('Échec de l’annulation')}
  };
}
</script>
</body>
</html>